<script>
	layui.use('form', function () {
        var form = layui.form;
        form.on('submit(formDemo_yuyue_tc)', function (data) {
            $.ajax({
                type: "POST",
                url: "/ajaxContact.php",
                data: {
                    name: data.field.name,
                    phone: data.field.phone,
                    company: data.field.company,
                    industry: data.field.industry,
                    content: data.field.content,
                    act:'yuyue',
                }
            }).done(function (data) {
                $(".tiptip").empty();
                $(".tiptip").append(data);
            });
            return false;
        });
    }); 
    layui.use('form', function () {
        var form = layui.form;
        form.on('submit(formDemo_tiyan)', function (data) {
            $.ajax({
                type: "POST",
                url: "/ajaxContact.php",
                data: {
                    name: data.field.name,
                    phone: data.field.phone,
                    email: data.field.email,
                    company: data.field.company,
                    industry: data.field.industry,
                    job: data.field.job,
                    content: data.field.content,
                    act:'tiyan',
                }
            }).done(function (data) {
                $(".tiptip").empty();
                $(".tiptip").append(data);
            });
            return false;
        });
    }); 
    


</script>

<script>
    var Swiper2 = new Swiper(".banner .swiper-container", {
        effect: 'fade',
        fadeEffect: {
            crossFade: true,
        },
        speed: 800,
        autoplay: {
            delay: 6000,
            disableOnInteraction: false,
        },
        navigation: {
            nextEl: ".banner .swip-r",
            prevEl: ".banner .swip-l",
        },
        pagination: { 
            el: ".banner .swiper-pagination",
            clickable: true,
        },
        on: {
            init: function (swiper) {
                $(".banner .swiper-pagination .swiper-pagination-bullet-active").addClass("cur").siblings().removeClass("cur");
            },
            slideChangeTransitionEnd: function () {
                $(".banner .swiper-pagination .swiper-pagination-bullet-active").addClass("cur").siblings().removeClass("cur");
            },
        },
    });
    
    const header = document.querySelector('.header')
    const banner = document.querySelector('.banner')
    const bannerBg = $('.banner .bg');

    // 封装计算赋值函数
    function setBannerStyle() {
        if(!header || !banner) return;
        // 获取header实际渲染高度（包含padding border）
        const headerHeight = header.offsetHeight
        // 1. 给banner设置margin-top
        banner.style.marginTop = `${headerHeight}px`
        // 2. bg高度：calc(100vh - 头部高度px)
        $(bannerBg).css('height','calc(100vh - '+headerHeight+'px)');
    }

    // 初始页面加载执行一次
    setBannerStyle()
    // 窗口缩放实时重新计算
    window.addEventListener('resize', setBannerStyle)

    $(window).on('scroll', function() {
        // 使用 requestAnimationFrame 节流
        if (window._scrollTimer) return;
        window._scrollTimer = requestAnimationFrame(function() {
            var scrollTop = $(window).scrollTop();
            var winHeight = $(window).height()/2;

            // ==========新增判断==========
            let maxPadding = window.innerWidth <= 1024 ? 15 : 30;

            var progress = Math.min(scrollTop / winHeight, 1); // 滚动进度 0~1
            var padding = maxPadding * (1 - progress); // 线性递减
            $('.banner').css('padding', '0 ' + padding + 'px');
            window._scrollTimer = null;
        });
    });

// 1. 先把每组原图克隆几份，保证数量铺满、loop 能建
$('.home_e .omee_btm .box').each(function(){
    var $wrap = $(this).find('.swiper-wrapper');
    var $src  = $wrap.children('.swiper-slide');
    for (var i = 0; i < 4; i++) {
        $wrap.append($src.clone());
    }
});

// 2. 再初始化三组轮播
$('.home_e .omee_btm .box').each(function(){
    new Swiper(this, {
        loop: true,
        speed: 4000,
        spaceBetween: 0,
        slidesPerView: 'auto',
        freeMode: { enabled: true, momentum: false },
        grabCursor: true,
        simulateTouch: false,
        loopAdditionalSlides: 10,
        autoplay: {
            delay: 1,
            disableOnInteraction: false,
            pauseOnMouseEnter: false,
        },
        breakpoints: {
            0:    { slidesPerView: 3,speed: 4000, },
            640:  { slidesPerView: 4,speed: 4000, },
            1025: { slidesPerView: 8.7,speed: 10000, },
        },
        on: {
            init: function(){ this.update(); },
            resize: function(){ this.update(); },
        }
    });
});



    
// 初始化swiper
var Swiper3 = new Swiper(".home_f .swiper-container", {
    speed: 500,
    slidesPerView: 2,
    centeredSlides: true,
    navigation: {
        nextEl: ".home_f .swip-r",
        prevEl: ".home_f .swip-l",
    },
    initialSlide: 1,
    breakpoints: {
        0: {
            slidesPerView: 1.2,
        },
        1025: {
            slidesPerView: 2,
        },
    },
});
// 保存实例变量
let Swiper3u = null;
let syncLock = false; // 防循环同步锁

// 初始化函数
function initSwiper3u() {
    if(window.innerWidth <= 1024 && !Swiper3u){
        Swiper3u = new Swiper(".home_f .toabne", {
            speed: 500,
            centeredSlides: true,
            initialSlide: Swiper3.realIndex, // 和主swiper当前索引对齐
            slidesPerView: 1,
            // ✅ 删掉 navigation！箭头只归Swiper3，这里不要绑定
            // 删掉 controller
        });

        // 主swiper变了，同步副swiper
        Swiper3.on('slideChange', function () {
            if (syncLock) return;
            syncLock = true;
            Swiper3u.slideTo(this.realIndex, 500);
            setTimeout(()=> syncLock = false, 500);
        })
        // 副swiper变了，同步主swiper
        Swiper3u.on('slideChange', function () {
            if (syncLock) return;
            syncLock = true;
            Swiper3.slideTo(this.realIndex, 500);
            setTimeout(()=> syncLock = false, 500);
        })
    }
}
// 销毁函数
function destroySwiper3u() {
    if(Swiper3u){
        // 销毁前解绑事件，防止残留监听
        Swiper3.off('slideChange');
        Swiper3u.off('slideChange');
        Swiper3u.destroy(true, true);
        Swiper3u = null;
    }
}
// 首次加载执行
initSwiper3u();
// 窗口大小变化监听
let resizeTimer;
window.addEventListener('resize', function(){
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function(){
        if(window.innerWidth <= 1024){
            initSwiper3u();
        }else{
            destroySwiper3u();
        }
    }, 150);
});

// ========== 下面全部原样保留，一点不动 ==========
// 获取所有文字标签
const amItems = document.querySelectorAll(".qiwen_am .am");
// 1. 点击文字切换轮播 + 切换cur
amItems.forEach(item => {
    item.addEventListener("click", function () {
        // 清除全部cur
        amItems.forEach(am => am.classList.remove("cur"));
        // 当前点击加cur
        this.classList.add("cur");
        // 获取下标，滑动到对应slide
        const targetIndex = Number(this.dataset.index);
        Swiper3.slideTo(targetIndex);
    })
})
// 2. 手动滑动轮播时，同步更新文字cur
Swiper3.on("slideChange", function () {
    // realIndex 获取loop模式真实下标
    const currentIndex = this.realIndex;
    amItems.forEach(am => am.classList.remove("cur"));
    document.querySelector(`.am[data-index="${currentIndex}"]`)?.classList.add("cur");
});


$(window).on('scroll', function() {
    // 使用 requestAnimationFrame 节流
    if (window._scrollTimer) return;
    window._scrollTimer = requestAnimationFrame(function() {
        var scrollTop = $(window).scrollTop();
        var winHeight = $(window).height()/2;
        var maxPadding = 30; // 初始内边距（px）
        var progress = Math.min(scrollTop / winHeight, 1); // 滚动进度 0~1
        var padding = maxPadding * (1 - progress); // 线性递减
        $('.banner').css('padding', '0 ' + padding + 'px');
        window._scrollTimer = null;
    });
});

document.querySelectorAll('a[href=""]').forEach(link => {
  link.addEventListener('click', function(e) {
    // 阻止默认跳转行为
    e.preventDefault();
    alert('敬请期待');
  })
})


    $(function(){
        var $box = $('.home_a .omea_btm .omeaw_r .menwsne');
        var $bar = $('.home_a .cotnnwe .dsiennc .dnwnse span');

        function updateBar(){
            var scrollWidth = $box[0].scrollWidth;      // 内容总宽
            var clientWidth = $box[0].clientWidth;      // 可视宽
            var maxScroll = scrollWidth - clientWidth;  // 最大可滚动距离

            if(maxScroll <= 0){
                // 内容不够滚，直接铺满
                $bar.css('width','100%');
                return;
            }

            var progress = $box.scrollLeft() / maxScroll;  // 0 ~ 1
            var startW = clientWidth / scrollWidth;       // 初始宽度（可视占总内容比例）
            var currentW = startW + (1 - startW) * progress;  // 从初始值线性涨到100%

            $bar.css('width', (currentW * 100) + '%');
        }

        $box.on('scroll', updateBar);   // 滚动时更新
        updateBar();                    // 初始化执行一次
        $(window).on('resize', updateBar);  // 窗口变化重算
    });


// 封装函数，jquery版本，先重置再取值，窗口resize自动重算
function setIsnemMaxHeight(){
    var $items = $('.eawr_li1 .isnem, .eawr_li2 .isnem, .eawr_li3 .isnem');
    $items.css('height','auto'); // 先清空，不然上次高度干扰测量
    var maxH = 0;
    $items.each(function(){
        var h = $(this).outerHeight(); // 包含padding，要纯内容高就换成 .height()
        if(h > maxH) maxH = h;
    })
    $items.css('height', maxH + 'px');
}

// 页面加载完执行
$(function(){
    setIsnemMaxHeight();
    // 窗口大小变化重新算（响应式）
    $(window).on('resize',function(){
        setIsnemMaxHeight();
    })
})

</script>
</body>
</html>